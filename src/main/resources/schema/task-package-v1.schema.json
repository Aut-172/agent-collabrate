{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-collab.local/schema/task-package-v1.schema.json",
  "title": "Agent Task Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "task", "project", "context", "objective", "scope", "nonGoals", "acceptanceCriteria", "verificationCommands", "executionPolicy", "allowedPaths", "forbiddenPaths", "deliverables"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "task": { "type": "object", "required": ["taskId", "workflowId", "taskVersion", "packageId", "packageVersion", "branchName", "packageHash", "status", "generatedAt"], "properties": { "taskId": { "type": "string" }, "workflowId": { "type": "string" }, "taskVersion": { "type": "integer", "minimum": 0 }, "packageId": { "type": "integer", "minimum": 1 }, "packageVersion": { "type": "integer", "minimum": 1 }, "branchName": { "type": "string", "minLength": 1 }, "packageHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "status": { "const": "CURRENT" }, "generatedAt": { "type": "string", "format": "date-time" } }, "additionalProperties": true },
    "project": { "type": "object", "required": ["projectId", "name", "repositoryUrl", "defaultBranch"], "additionalProperties": true },
    "context": {
      "type": "object",
      "required": ["designVersion", "specVersion", "buildPlanVersion", "codeContextVersionId", "contextPlanId", "baseBranch", "baseCommitSha", "baseCommit", "relevantPaths", "codeEvidence"],
      "properties": {
        "designVersion": { "type": "integer", "minimum": 0 },
        "specVersion": { "type": "integer", "minimum": 0 },
        "buildPlanVersion": { "type": "integer", "minimum": 1 },
        "codeContextVersionId": { "type": "integer", "minimum": 1 },
        "contextPlanId": { "type": "integer", "minimum": 1 },
        "baseBranch": { "type": "string", "minLength": 1 },
        "baseCommitSha": { "type": "string", "minLength": 7, "maxLength": 100 },
        "baseCommit": { "type": "string", "minLength": 7, "maxLength": 100 },
        "relevantPaths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "codeEvidence": { "type": "array", "items": { "$ref": "#/$defs/codeEvidence" } }
      },
      "additionalProperties": false
    },
    "assignee": { "type": "object" },
    "objective": { "type": "string", "minLength": 1 },
    "scope": { "$ref": "#/$defs/nonEmptyStringList" },
    "nonGoals": { "$ref": "#/$defs/stringList" },
    "acceptanceCriteria": { "$ref": "#/$defs/nonEmptyStringList" },
    "verificationCommands": { "$ref": "#/$defs/nonEmptyStringList" },
    "blockerHistory": { "type": "array", "items": { "$ref": "#/$defs/blockerHistory" } },
    "executionPolicy": { "type": "object", "required": ["mode", "git"], "additionalProperties": true },
    "allowedPaths": { "type": "array" },
    "forbiddenPaths": { "type": "array" },
    "deliverables": { "$ref": "#/$defs/stringList" }
  },
  "$defs": {
    "stringList": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "nonEmptyStringList": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "codeEvidence": {
      "type": "object",
      "required": ["path", "reason", "summary"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "blockerHistory": {
      "type": "object",
      "required": ["id", "reasonCode", "summary", "status", "resolution"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "reasonCode": { "enum": ["REQUIREMENT_CLARIFICATION", "SPEC_CONFLICT", "DEPENDENCY", "ENVIRONMENT", "PERMISSION", "CI_FAILURE", "TASK_PACKAGE_UPDATED", "OTHER"] },
        "summary": { "type": "string", "minLength": 1 },
        "status": { "enum": ["RESOLVED", "CANCELLED"] },
        "resolution": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
