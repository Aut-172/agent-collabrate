DB_NAME=agent_collab
DB_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173
DB_URL=jdbc:postgresql://localhost:5432/agent_collab
DB_USERNAME=agent_collab
# PostgreSQL applies this value only when initializing an empty data volume.
DB_PASSWORD=replace-with-a-random-database-password
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION_MS=3600000
GIT_PROVIDER=github
GIT_API_URL=https://api.github.com
GIT_TOKEN=
CI_WEBHOOK_SECRET=
AGENT_PROVIDER=unconfigured
AGENT_API_URL=https://api.openai.com/v1/responses
AGENT_API_KEY=
AGENT_MODEL=
AGENT_REVIEW_MODEL=
AGENT_REASONING_EFFORT=xhigh
AGENT_DISABLE_RESPONSE_STORAGE=true
AGENT_NETWORK_ACCESS=enabled
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_OUTPUT_TOKENS=12000
AGENT_DIAGNOSTICS_ENABLED=false
